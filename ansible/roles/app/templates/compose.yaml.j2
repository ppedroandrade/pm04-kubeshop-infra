# Gerenciado pelo Ansible - não edite na VM.
# Adaptação do compose.yaml original para hosts separados: o MongoDB roda na
# VM exclusiva e é acessado pelo IP privado {{ db_private_ip }}.
name: kubeshop-app

x-logging: &logging
  driver: json-file
  options: { max-size: "10m", max-file: "3" }

services:
  frontend:
    image: {{ docker_image }}-frontend:{{ docker_tag }}
    container_name: kubeshop-frontend
    depends_on:
      api:
        condition: service_healthy
    restart: unless-stopped
    init: true
    read_only: true
    tmpfs:
      - /tmp:size=32m,mode=1777
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    healthcheck:
      test: [CMD, wget, -q, -O, /dev/null, "http://127.0.0.1:8080/healthz"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 10s
    networks: [web]
    logging: *logging

  api:
    image: {{ docker_image }}-api:{{ docker_tag }}
    container_name: kubeshop-api
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: "3000"
      APP_VERSION: "{{ docker_tag }}"
      MONGO_HOST: "{{ db_private_ip }}"
      MONGO_PORT: "27017"
      MONGO_DATABASE: kubeshop
      MONGO_AUTH_SOURCE: kubeshop
      MONGO_USERNAME: kubeshop
      MONGO_PASSWORD_FILE: /run/secrets/mongo_app_password
    secrets: [mongo_app_password]
    restart: unless-stopped
    init: true
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    stop_grace_period: 20s
    healthcheck:
      test: [CMD, node, -e, "fetch('http://127.0.0.1:3000/api/health/ready',{signal:AbortSignal.timeout(2500)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 4s
      retries: 3
      start_period: 30s
    networks: [web]
    logging: *logging

{% if admin_enabled | bool %}
  # Painel /admin: sem porta publicada, sem Docker socket. Só alcançável pelo
  # Caddy (HTTPS + login). Executa rotinas nas VMs via SSH com comando forçado.
  admin:
    build: ./admin
    image: kubeshop-admin:{{ admin_build_hash }}
    container_name: kubeshop-admin
    environment:
      APP_HOST: "{{ app_private_ip }}"
      DB_HOST: "{{ db_private_ip }}"
      SSH_USER: "{{ ansible_user }}"
    secrets: [admin_ssh_key]
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:size=8m,mode=1777
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    networks: [web]
    logging: *logging

{% endif %}
  # Entrada pública: HTTP 80 e HTTPS 443 com certificado automático.
  caddy:
    image: caddy:{{ caddy_tag }}
    container_name: kubeshop-caddy
    ports:
      - "{{ app_http_port }}:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      frontend:
        condition: service_healthy
    restart: unless-stopped
    cap_drop: [ALL]
    cap_add: [NET_BIND_SERVICE]
    security_opt: [no-new-privileges:true]
    healthcheck:
      test: [CMD, wget, -q, -O, /dev/null, "http://127.0.0.1:80/healthz"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 10s
    networks: [web]
    logging: *logging

networks:
  web:

volumes:
  # certificados emitidos ficam aqui (evita reemissão a cada deploy)
  caddy-data:
  caddy-config:

secrets:
  mongo_app_password:
    file: ./secrets/mongo-app-password
{% if admin_enabled | bool %}
  admin_ssh_key:
    file: ./secrets/admin-ssh-key
{% endif %}
