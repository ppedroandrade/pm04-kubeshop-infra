# Gerenciado pelo Ansible - não edite na VM.
# Entrada pública da loja:
#   - HTTP  :80  -> serve normalmente (também por IP) e responde ao desafio ACME
#   - HTTPS :443 -> certificado automático (Let's Encrypt) para {{ app_fqdn }}
# Os redirecionamentos HTTP->HTTPS ficam desligados: se a emissão do certificado
# falhar, a loja continua acessível por HTTP.
{
	auto_https disable_redirects
{% if acme_email | length > 0 %}
	email {{ acme_email }}
{% endif %}
}

:80 {
{% if admin_enabled | bool and app_fqdn | length > 0 %}
	# o painel só funciona em HTTPS
	redir /admin* https://{{ app_fqdn }}/admin/ 302
{% endif %}
	reverse_proxy frontend:8080
}

{% if app_fqdn | length > 0 %}
{{ app_fqdn }}:443 {
	encode gzip
	header Strict-Transport-Security "max-age=300"
{% if admin_enabled | bool %}
	# login, sessão e bloqueio de força bruta ficam no próprio painel
	handle /admin* {
		reverse_proxy kubeshop-admin:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
{% endif %}
	handle {
		reverse_proxy frontend:8080
	}
}
{% endif %}
